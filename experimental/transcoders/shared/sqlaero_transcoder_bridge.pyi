"""Typed experimental public interface; compiled consumers must rebuild."""
from typing import Any
class ObjStr:
    """Trusted SQL expression hook."""
    def __str__(self) -> str: ...
class CustomEscapeType(ObjStr):
    """Trusted hook carrying a read-only payload."""
    def __init__(self, obj: object) -> None: ...
    @property
    def obj(self) -> object: ...
    def __repr__(self) -> str: ...
    def __str__(self) -> str: ...
class BIT(CustomEscapeType):
    """Checked unsigned 64-bit BIT payload."""
    def __str__(self) -> str: ...
class JSON(CustomEscapeType):
    """Python tree serialized by a self-implemented JSON kernel."""
    def __str__(self) -> str: ...
def configure_backend(name: str) -> None: ...
def escape(data: object, many: bool = False, itemize: bool = True) -> str | tuple[Any, ...] | list[Any]: ...
def decode(value: bytes, field_type: int, encoding: bytes, is_binary: bool, use_decimal: bool = False, decode_bit: bool = False, decode_json: bool = False) -> object: ...
